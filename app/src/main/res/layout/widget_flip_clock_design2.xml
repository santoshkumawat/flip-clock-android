<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingTop="10dp"
    android:paddingEnd="14dp"
    android:paddingBottom="10dp">

    <TextClock
        android:id="@+id/date_header"
        android:layout_width="match_parent"
        android:layout_height="20dp"
        android:format12Hour="MMMM d, yyyy"
        android:format24Hour="MMMM d, yyyy"
        android:ellipsize="end"
        android:fontFamily="sans-serif"
        android:gravity="center"
        android:singleLine="true"
        android:textColor="#F6F6F3"
        android:textSize="15sp"
        android:textFontWeight="800"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:id="@+id/hours_card"
            style="@style/ClockPairDesign2">
            <FrameLayout
                android:id="@+id/hours_digits"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:paddingHorizontal="4dp">
                    <ViewFlipper
                        android:id="@+id/digit_flipper_0"
                        style="@style/ClockDigit"
                        android:layout_marginEnd="-12dp"
                        android:animateFirstView="true"
                        android:inAnimation="@anim/drop_in"
                        android:outAnimation="@anim/drop_out">
                        <TextView android:id="@+id/digit_0_a" style="@style/ClockDigitText" />
                        <TextView android:id="@+id/digit_0_b" style="@style/ClockDigitText" />
                    </ViewFlipper>
                    <ViewFlipper
                        android:id="@+id/digit_flipper_1"
                        style="@style/ClockDigit"
                        android:animateFirstView="true"
                        android:inAnimation="@anim/drop_in"
                        android:outAnimation="@anim/drop_out">
                        <TextView android:id="@+id/digit_1_a" style="@style/ClockDigitText" />
                        <TextView android:id="@+id/digit_1_b" style="@style/ClockDigitText" />
                    </ViewFlipper>
                </LinearLayout>
                <FrameLayout style="@style/ClockPairSeam" />
            </FrameLayout>
        </FrameLayout>

        <LinearLayout
            android:layout_width="34dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical">
            <TextView
                android:id="@+id/period"
                android:layout_width="match_parent"
                android:layout_height="18dp"
                android:fontFamily="sans-serif-condensed"
                android:gravity="center"
                android:textColor="#F6F6F3"
                android:textSize="15sp"
                android:textStyle="bold"
                android:visibility="gone" />
            <FrameLayout
                android:id="@+id/seconds_container"
                android:layout_width="match_parent"
                android:layout_height="18dp">
                <ViewFlipper
                    android:id="@+id/seconds_flipper"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:animateFirstView="false"
                    android:autoStart="true"
                    android:flipInterval="1000"
                    android:inAnimation="@anim/seconds_in"
                    android:outAnimation="@anim/seconds_out">
                    <TextView style="@style/ClockSecondsText" android:text="00" />
                    <TextView style="@style/ClockSecondsText" android:text="01" />
                    <TextView style="@style/ClockSecondsText" android:text="02" />
                    <TextView style="@style/ClockSecondsText" android:text="03" />
                    <TextView style="@style/ClockSecondsText" android:text="04" />
                    <TextView style="@style/ClockSecondsText" android:text="05" />
                    <TextView style="@style/ClockSecondsText" android:text="06" />
                    <TextView style="@style/ClockSecondsText" android:text="07" />
                    <TextView style="@style/ClockSecondsText" android:text="08" />
                    <TextView style="@style/ClockSecondsText" android:text="09" />
                    <TextView style="@style/ClockSecondsText" android:text="10" />
                    <TextView style="@style/ClockSecondsText" android:text="11" />
                    <TextView style="@style/ClockSecondsText" android:text="12" />
                    <TextView style="@style/ClockSecondsText" android:text="13" />
                    <TextView style="@style/ClockSecondsText" android:text="14" />
                    <TextView style="@style/ClockSecondsText" android:text="15" />
                    <TextView style="@style/ClockSecondsText" android:text="16" />
                    <TextView style="@style/ClockSecondsText" android:text="17" />
                    <TextView style="@style/ClockSecondsText" android:text="18" />
                    <TextView style="@style/ClockSecondsText" android:text="19" />
                    <TextView style="@style/ClockSecondsText" android:text="20" />
                    <TextView style="@style/ClockSecondsText" android:text="21" />
                    <TextView style="@style/ClockSecondsText" android:text="22" />
                    <TextView style="@style/ClockSecondsText" android:text="23" />
                    <TextView style="@style/ClockSecondsText" android:text="24" />
                    <TextView style="@style/ClockSecondsText" android:text="25" />
                    <TextView style="@style/ClockSecondsText" android:text="26" />
                    <TextView style="@style/ClockSecondsText" android:text="27" />
                    <TextView style="@style/ClockSecondsText" android:text="28" />
                    <TextView style="@style/ClockSecondsText" android:text="29" />
                    <TextView style="@style/ClockSecondsText" android:text="30" />
                    <TextView style="@style/ClockSecondsText" android:text="31" />
                    <TextView style="@style/ClockSecondsText" android:text="32" />
                    <TextView style="@style/ClockSecondsText" android:text="33" />
                    <TextView style="@style/ClockSecondsText" android:text="34" />
                    <TextView style="@style/ClockSecondsText" android:text="35" />
                    <TextView style="@style/ClockSecondsText" android:text="36" />
                    <TextView style="@style/ClockSecondsText" android:text="37" />
                    <TextView style="@style/ClockSecondsText" android:text="38" />
                    <TextView style="@style/ClockSecondsText" android:text="39" />
                    <TextView style="@style/ClockSecondsText" android:text="40" />
                    <TextView style="@style/ClockSecondsText" android:text="41" />
                    <TextView style="@style/ClockSecondsText" android:text="42" />
                    <TextView style="@style/ClockSecondsText" android:text="43" />
                    <TextView style="@style/ClockSecondsText" android:text="44" />
                    <TextView style="@style/ClockSecondsText" android:text="45" />
                    <TextView style="@style/ClockSecondsText" android:text="46" />
                    <TextView style="@style/ClockSecondsText" android:text="47" />
                    <TextView style="@style/ClockSecondsText" android:text="48" />
                    <TextView style="@style/ClockSecondsText" android:text="49" />
                    <TextView style="@style/ClockSecondsText" android:text="50" />
                    <TextView style="@style/ClockSecondsText" android:text="51" />
                    <TextView style="@style/ClockSecondsText" android:text="52" />
                    <TextView style="@style/ClockSecondsText" android:text="53" />
                    <TextView style="@style/ClockSecondsText" android:text="54" />
                    <TextView style="@style/ClockSecondsText" android:text="55" />
                    <TextView style="@style/ClockSecondsText" android:text="56" />
                    <TextView style="@style/ClockSecondsText" android:text="57" />
                    <TextView style="@style/ClockSecondsText" android:text="58" />
                    <TextView style="@style/ClockSecondsText" android:text="59" />
                </ViewFlipper>
            </FrameLayout>
        </LinearLayout>

        <FrameLayout
            android:id="@+id/minutes_card"
            style="@style/ClockPairDesign2">
            <FrameLayout
                android:id="@+id/minutes_digits"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:paddingHorizontal="4dp">
                    <ViewFlipper
                        android:id="@+id/digit_flipper_2"
                        style="@style/ClockDigit"
                        android:layout_marginEnd="-12dp"
                        android:animateFirstView="true"
                        android:inAnimation="@anim/drop_in"
                        android:outAnimation="@anim/drop_out">
                        <TextView android:id="@+id/digit_2_a" style="@style/ClockDigitText" />
                        <TextView android:id="@+id/digit_2_b" style="@style/ClockDigitText" />
                    </ViewFlipper>
                    <ViewFlipper
                        android:id="@+id/digit_flipper_3"
                        style="@style/ClockDigit"
                        android:animateFirstView="true"
                        android:inAnimation="@anim/drop_in"
                        android:outAnimation="@anim/drop_out">
                        <TextView android:id="@+id/digit_3_a" style="@style/ClockDigitText" />
                        <TextView android:id="@+id/digit_3_b" style="@style/ClockDigitText" />
                    </ViewFlipper>
                </LinearLayout>
                <FrameLayout style="@style/ClockPairSeam" />
            </FrameLayout>
        </FrameLayout>
    </LinearLayout>

    <TextClock
        android:id="@+id/weekday_header"
        android:layout_width="match_parent"
        android:layout_height="20dp"
        android:format12Hour="EEEE"
        android:format24Hour="EEEE"
        android:ellipsize="end"
        android:fontFamily="sans-serif"
        android:gravity="center"
        android:singleLine="true"
        android:textColor="#F6F6F3"
        android:textSize="15sp"
        android:textFontWeight="800"
        android:textStyle="bold" />
</LinearLayout>
