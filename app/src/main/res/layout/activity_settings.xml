<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F5F8"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="40dp"
        android:paddingEnd="24dp"
        android:paddingBottom="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_title"
            android:textColor="#17191D"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="22dp"
            android:text="@string/settings_subtitle"
            android:textColor="#626873"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/settings_card"
            android:gravity="center_vertical"
            android:minHeight="88dp"
            android:orientation="horizontal"
            android:paddingStart="18dp"
            android:paddingTop="14dp"
            android:paddingEnd="14dp"
            android:paddingBottom="14dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingEnd="12dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/time_format_title"
                    android:textColor="#20232A"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/time_format_summary"
                    android:textColor="#6D737D"
                    android:textSize="13sp" />
            </LinearLayout>

            <Switch
                android:id="@+id/format_24_switch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/format_24"
                android:showText="false"
                android:textOff=""
                android:textOn="" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/settings_card"
            android:gravity="center_vertical"
            android:minHeight="88dp"
            android:orientation="horizontal"
            android:paddingStart="18dp"
            android:paddingTop="14dp"
            android:paddingEnd="14dp"
            android:paddingBottom="14dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingEnd="12dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/show_seconds"
                    android:textColor="#20232A"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/show_seconds_summary"
                    android:textColor="#6D737D"
                    android:textSize="13sp" />
            </LinearLayout>

            <Switch
                android:id="@+id/show_seconds"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/show_seconds"
                android:showText="false"
                android:textOff=""
                android:textOn="" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/settings_card"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingTop="16dp"
            android:paddingEnd="18dp"
            android:paddingBottom="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/design_title"
                android:textColor="#20232A"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/design_summary"
                android:textColor="#6D737D"
                android:textSize="13sp" />

            <RadioGroup
                android:id="@+id/design_options"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/design_1"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:buttonTint="#536DFE"
                    android:gravity="center_vertical"
                    android:text="@string/design_1"
                    android:textColor="#20232A"
                    android:textSize="15sp" />

                <RadioButton
                    android:id="@+id/design_2"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:buttonTint="#536DFE"
                    android:gravity="center_vertical"
                    android:text="@string/design_2"
                    android:textColor="#20232A"
                    android:textSize="15sp" />

                <RadioButton
                    android:id="@+id/design_3"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:buttonTint="#536DFE"
                    android:gravity="center_vertical"
                    android:text="@string/design_3"
                    android:textColor="#20232A"
                    android:textSize="15sp" />
            </RadioGroup>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:text="@string/update_settings_title"
            android:textColor="#20232A"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/precise_updates"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/precise_button"
            android:drawableStart="@drawable/ic_alarm"
            android:drawablePadding="10dp"
            android:drawableTint="#536DFE"
            android:elevation="2dp"
            android:gravity="center"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:text="@string/precise_updates"
            android:textAllCaps="false"
            android:textColor="#20232A"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/precise_updates_explanation"
            android:textColor="#6D737D"
            android:textSize="13sp" />
    </LinearLayout>
</ScrollView>
